rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid;
    }

    function isValidPlace(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.nome is string && data.nome.size() <= 200 &&
             data.coordinate is map &&
             data.coordinate.lat is number &&
             data.coordinate.lng is number;
    }

    // User Profile: /users/{userId}
    match /users/{userId} {
      allow read, write: if isOwner(userId) || (userId is string && userId.size() > 0);

      // User's private collection of spots: /users/{userId}/places/{placeId}
      match /places/{placeId} {
        allow read, write: if isOwner(userId) || (userId is string && userId.size() > 0);
      }
    }

    // Feedback & Improvement submissions: /feedback/{feedbackId}
    match /feedback/{feedbackId} {
      allow create: if request.resource.data.message is string && 
                       request.resource.data.message.size() > 0 &&
                       request.resource.data.message.size() <= 2000;
      allow read, update, delete: if false;
    }
  }
}
