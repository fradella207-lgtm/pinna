rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default-deny global safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128;
    }

    function isValidUser(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid;
    }

    function isValidPlace(data, userId) {
      return data.userId == userId &&
             data.userId == request.auth.uid &&
             data.id is string && data.id.size() <= 128 &&
             data.nome is string && data.nome.size() <= 200 &&
             data.coordinate is map &&
             data.coordinate.lat is number &&
             data.coordinate.lng is number;
    }

    // User Profile: /users/{userId}
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create: if isOwner(userId) && isValidUser(request.resource.data, userId);
      allow update: if isOwner(userId) && 
                       isValidUser(request.resource.data, userId) && 
                       request.resource.data.userId == resource.data.userId;
      allow delete: if isOwner(userId);

      // User's private collection of spots: /users/{userId}/places/{placeId}
      match /places/{placeId} {
        allow get, list: if isOwner(userId);
        
        allow create: if isOwner(userId) && 
                         isValidId(placeId) && 
                         isValidPlace(request.resource.data, userId);
        
        allow update: if isOwner(userId) && 
                         isValidPlace(request.resource.data, userId) &&
                         request.resource.data.userId == resource.data.userId;
        
        allow delete: if isOwner(userId);
      }
    }
  }
}
